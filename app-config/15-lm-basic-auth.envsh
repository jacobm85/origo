#!/bin/sh
# Beräknar Basic Auth-headern för Lantmäteriets visningstjänster (WMTS-
# bakgrundskartor) från den gemensamma inloggningen LM_USER/LM_PASS och
# exponerar den som $LM_BASIC_AUTH.
#
# Filen har ändelsen .envsh så att nginx-imagens entrypoint *sourcar* den
# (i stället för att köra den i en subshell). Då lever exporten kvar och kan
# användas av nästa steg, 20-envsubst-on-templates.sh, som ersätter
# ${LM_BASIC_AUTH} i nginx-mallen. base64:en innehåller aldrig några
# $-tecken, så envsubst rör den inte.
#
# Resultatet: uppgifterna injiceras server-side och lämnar aldrig containern,
# precis som LM_BEARER_TOKEN och Basic Auth i ortofoto-/iono-tjänsterna.
LM_USER="${LM_USER:-}"
LM_PASS="${LM_PASS:-}"
export LM_BASIC_AUTH="$(printf '%s' "${LM_USER}:${LM_PASS}" | base64 | tr -d '\n')"
