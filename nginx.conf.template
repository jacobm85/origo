server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Skicka RELATIVA Location-headers ("/login" i stället för
    # "http://host/login"). nginx bygger annars (absolute_redirect on, default)
    # en absolut URL ur Host-headern och kan då tappa bort porten — vid direkt
    # åtkomst på t.ex. host:8080 hamnade login-redirecten på host (port 80),
    # där en annan tjänst/HSTS uppgraderade till https och sidan inte kunde nås.
    # Relativ redirect gör att webbläsaren behåller scheme + port från adressen
    # den faktiskt surfade till.
    absolute_redirect off;

    resolver 1.1.1.1 8.8.8.8 valid=300s ipv6=off;
    resolver_timeout 5s;

    # ---- Session auth via auth_request ----
    # /auth/check is proxied to the auth service; returns 200 or 401.
    # On 401 the user is redirected to /login (no browser dialog).
    location /internal/auth_check {
        internal;
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $auth_upstream http://auth:3000;
        proxy_pass $auth_upstream/auth/check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        # Keep the per-request auth check snappy so it can't pile up.
        proxy_connect_timeout 2s;
        proxy_read_timeout 2s;
        proxy_send_timeout 2s;
    }

    location = /login {
        try_files /login.html =404;
    }

    location = /auth/login {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $auth_upstream http://auth:3000;
        proxy_pass $auth_upstream/auth/login;
        proxy_set_header Content-Type $content_type;
        proxy_pass_request_body on;
    }

    location / {
        auth_request /internal/auth_check;
        error_page 401 = @login_redirect;
        # no-cache = webbläsaren MÅSTE validera mot servern (villkorlig begäran
        # med ETag) innan en cachad kopia används. nginx svarar 304 om filen är
        # oförändrad, annars 200 med nytt innehåll. Det gör att ny plugin-JS/
        # index.json plockas upp direkt efter en deploy i stället för att fastna
        # på en gammal cachad version (orsakade "Body måste innehålla items"-
        # felet när gammal laserdata-JS postade 'cells' mot nya backenden).
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }

    location @login_redirect {
        return 302 /login;
    }

    # ---- SGU GeoServer (no upstream CORS) ----
    location /proxy/sgu/ {
        proxy_pass https://maps3.sgu.se/geoserver/;
        proxy_ssl_server_name on;
        proxy_set_header Host maps3.sgu.se;
        proxy_set_header Origin "";
        proxy_set_header User-Agent "origo-proxy/1.0";
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "*" always;
    }

    # ---- Lantmateriet "Hitta stompunkt" e-tjanst (oppna data, CC0) ----------- #
    # Den publika e-tjansten stompunkt.lantmateriet.se exponerar ett oppet
    # REST-API (ingen auth) men utan CORS-headers, sa anropen maste ga via
    # proxyn. Klienten anvander:
    #   POST /proxy/stompunkt/api/filter?includeForstorda=<bool>  (GeoJSON-bbox -> punkter i vyn)
    #   POST /proxy/stompunkt/api/id?srid=3006                    (array av id -> detaljer)
    # Koordinater i SWEREF 99 TM (EPSG:3006). Datat ar CC0 (Creative Commons noll).
    location /proxy/stompunkt/ {
        proxy_pass https://stompunkt.lantmateriet.se/;
        proxy_ssl_server_name on;
        proxy_set_header Host stompunkt.lantmateriet.se;
        proxy_set_header Origin "";
        proxy_set_header User-Agent "origo-proxy/1.0";
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "*" always;
        if ($request_method = OPTIONS) { return 204; }
    }

    # ---- Lansstyrelsen INSPIRE OWS (no upstream CORS) ----
    location /proxy/lst/ {
        proxy_pass https://ext-geodata-ows.lansstyrelsen.se/;
        proxy_ssl_server_name on;
        proxy_set_header Host ext-geodata-ows.lansstyrelsen.se;
        proxy_set_header Origin "";
        proxy_set_header User-Agent "origo-proxy/1.0";
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "*" always;
    }

    # ---- Lansstyrelsen EBH (Forenade omraden) - ArcGIS REST service base ----
    # Proxied one level above MapServer so OL TileArcGISRest can append
    # /MapServer/export (it requires the URL to end with "MapServer"
    # for its regex .replace(/MapServer\/?$/, "MapServer/export") to fire).
    # The Origo source URL therefore needs to be "/proxy/lst-ebh/MapServer".
    location /proxy/lst-ebh/ {
        proxy_pass https://ext-geodata-nationella-visning.lansstyrelsen.se/arcgis/rest/services/LST/LST_Potentiellt_fororenade_omraden_EBH_EXT/;
        proxy_ssl_server_name on;
        proxy_set_header Host ext-geodata-nationella-visning.lansstyrelsen.se;
        proxy_set_header Origin "";
        proxy_set_header User-Agent "origo-proxy/1.0";
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
    }

    # ---- Vindbrukskollen - ArcGIS REST service base ----
    # Source URL must be "/proxy/lst-vbk/MapServer" (see EBH note above).
    location /proxy/lst-vbk/ {
        proxy_pass https://ext-geodata-applikationer.lansstyrelsen.se/arcgis/rest/services/VBK/lst_vbk_wms_vindbrukskollen/;
        proxy_ssl_server_name on;
        proxy_set_header Host ext-geodata-applikationer.lansstyrelsen.se;
        proxy_set_header Origin "";
        proxy_set_header User-Agent "origo-proxy/1.0";
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
    }

    # ---- VISS (Vatteninformationssystem Sverige) - ArcGIS REST service base ----
    # Source-URL ska vara "/proxy/lst-viss/<tjanst>/MapServer" (se EBH-noten ovan).
    location /proxy/lst-viss/ {
        proxy_pass https://ext-geodata-applikationer.lansstyrelsen.se/arcgis/rest/services/VISS/;
        proxy_ssl_server_name on;
        proxy_set_header Host ext-geodata-applikationer.lansstyrelsen.se;
        proxy_set_header Origin "";
        proxy_set_header User-Agent "origo-proxy/1.0";
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
    }

    # ---- Naturvardsverket geoserver (Skyddad natur, Natura2000, vattenskydd) ----
    location /proxy/nv/ {
        proxy_pass https://geodata.naturvardsverket.se/geoserver/;
        proxy_ssl_server_name on;
        proxy_set_header Host geodata.naturvardsverket.se;
        proxy_set_header Origin "";
        proxy_set_header User-Agent "origo-proxy/1.0";
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
    }

    # ---- Havs- och vattenmyndigheten GeoServer (no upstream CORS) ----
    location /proxy/hav/ {
        proxy_pass https://geodata.havochvatten.se/;
        proxy_ssl_server_name on;
        proxy_set_header Host geodata.havochvatten.se;
        proxy_set_header Origin "";
        proxy_set_header User-Agent "origo-proxy/1.0";
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "*" always;
    }

    # ---- Naturvardsverket ljudmiljo WMS (separat tjanst, ej /geoserver/) ----
    location /proxy/nv-ljud/ {
        proxy_pass https://geodata.naturvardsverket.se/;
        proxy_ssl_server_name on;
        proxy_set_header Host geodata.naturvardsverket.se;
        proxy_set_header Origin "";
        proxy_set_header User-Agent "origo-proxy/1.0";
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "*" always;
    }

    # ---- MSB INSPIRE OWS (skyddsrum, stabilitet, seveso) ----
    location /proxy/msb/ {
        proxy_pass https://inspire.msb.se/;
        proxy_ssl_server_name on;
        proxy_set_header Host inspire.msb.se;
        proxy_set_header Origin "";
        proxy_set_header User-Agent "origo-proxy/1.0";
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "*" always;
    }

    # ---- Riksantikvarieambetet (Kulturmiljoregistret - lamningar) ----
    location /proxy/raa/ {
        proxy_pass https://pub.raa.se/;
        proxy_ssl_server_name on;
        proxy_set_header Host pub.raa.se;
        proxy_set_header Origin "";
        proxy_set_header User-Agent "origo-proxy/1.0";
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "*" always;
    }

    # ---- Metria/Svenska kraftnat GeoServer (transmissionsnat for el) ----
    location /proxy/metria-skn/ {
        proxy_pass https://inspire-skn.metria.se/;
        proxy_ssl_server_name on;
        proxy_set_header Host inspire-skn.metria.se;
        proxy_set_header Origin "";
        proxy_set_header User-Agent "origo-proxy/1.0";
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "*" always;
    }

    # ---- Naturvardsverket "andra_skydd" WMS (riksintressen naturvard/friluftsliv) ----
    location /proxy/nv-andra/ {
        proxy_pass https://geodata.naturvardsverket.se/;
        proxy_ssl_server_name on;
        proxy_set_header Host geodata.naturvardsverket.se;
        proxy_set_header Origin "";
        proxy_set_header User-Agent "origo-proxy/1.0";
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "*" always;
    }

    # ---- SGU resource WMS (riksintressen mineral) ----
    location /proxy/sgu-ri/ {
        proxy_pass https://resource.sgu.se/;
        proxy_ssl_server_name on;
        proxy_set_header Host resource.sgu.se;
        proxy_set_header Origin "";
        proxy_set_header User-Agent "origo-proxy/1.0";
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "*" always;
    }

    # ---- Lansstyrelsen nationella visning - ArcGIS WMSServer (riksintressen) ----
    # Source-URL ska vara hela WMSServer-vagen, t.ex.
    # /proxy/lst-visning/arcgis/services/LST/LST_Riksintressen_EXT/MapServer/WMSServer
    location /proxy/lst-visning/ {
        proxy_pass https://ext-geodata-nationella-visning.lansstyrelsen.se/;
        proxy_ssl_server_name on;
        proxy_set_header Host ext-geodata-nationella-visning.lansstyrelsen.se;
        proxy_set_header Origin "";
        proxy_set_header User-Agent "origo-proxy/1.0";
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "*" always;
    }

    # ---- Lansstyrelsen lokala - ArcGIS WMSServer (vardefulla vatten/kulturmiljo) ----
    location /proxy/lst-lokala/ {
        proxy_pass https://ext-geodata-lokala.lansstyrelsen.se/;
        proxy_ssl_server_name on;
        proxy_set_header Host ext-geodata-lokala.lansstyrelsen.se;
        proxy_set_header Origin "";
        proxy_set_header User-Agent "origo-proxy/1.0";
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "*" always;
    }

    # ---- Trafikverket riksintressen WMS (upstream ar plain http) ----
    location /proxy/trv-ri/ {
        proxy_pass http://geo-ri.trafikverket.se/;
        proxy_set_header Host geo-ri.trafikverket.se;
        proxy_set_header Origin "";
        proxy_set_header User-Agent "origo-proxy/1.0";
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "*" always;
    }

    # ---- GeoServer (shared "Eget lager" via WFS-T) ----
    # Proxies to the geoserver service on the compose network. Using a variable
    # upstream + the Docker embedded DNS resolver (127.0.0.11) means nginx
    # starts even if GeoServer isn't up yet and resolves the name per request.
    # WFS-T POSTs an XML body, so allow a generous body size.
    location /proxy/geoserver/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $geoserver_upstream http://geoserver:8080;
        rewrite ^/proxy/geoserver/(.*)$ /geoserver/$1 break;
        proxy_pass $geoserver_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 25m;
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "*" always;
        if ($request_method = OPTIONS) { return 204; }
    }

    # ---- Laserdata backend (markera rutor + ladda ner LAZ som zip) ----
    # Proxas till laserdata-tjänsten på compose-nätet. Gated bakom inloggningen
    # (same-origin → cookien följer med). Buffring av i/o och stora timeouts så
    # zip-strömmen (kan vara flera GB) kan flöda direkt till klienten.
    location /api/laserdata/ {
        auth_request /internal/auth_check;
        error_page 401 = @login_redirect;
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $laserdata_upstream http://laserdata:3001;
        proxy_pass $laserdata_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_buffering off;
        proxy_request_buffering off;
        client_max_body_size 5m;
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
    }

    # ---- Ortofoto backend (sök Lantmateriets STAC-bild + ladda ner som zip) ----
    # Proxas till ortofoto-tjänsten på compose-nätet. Gated bakom inloggningen.
    # Basic Auth mot Lantmateriet injiceras i tjänsten (lämnar aldrig servern).
    # Buffring av i/o och stora timeouts så zip-strömmen (kan vara flera GB
    # ortofoton) kan flöda direkt till klienten.
    location /api/ortofoto/ {
        auth_request /internal/auth_check;
        error_page 401 = @login_redirect;
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $ortofoto_upstream http://ortofoto:3003;
        proxy_pass $ortofoto_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_buffering off;
        proxy_request_buffering off;
        client_max_body_size 5m;
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
    }

    # ---- Jonosfär Direkt (Lantmateriet) – Basic Auth injiceras server-side ----
    # iono-tjänsten lägger på Authorization: Basic från IONO_USER/IONO_PASS, så
    # uppgifterna lämnar aldrig servern. Gated bakom inloggningen.
    location /proxy/iono/ {
        auth_request /internal/auth_check;
        error_page 401 = @login_redirect;
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $iono_upstream http://iono:3002;
        rewrite ^/proxy/iono/(.*)$ /iono/$1 break;
        proxy_pass $iono_upstream;
        proxy_set_header Host $host;
    }

    # ---- Befolkning (SCB rutstatistik 1 km + ytviktad beräkning) ----
    # Proxas till befolkning-tjänsten på compose-nätet. Gated bakom inloggningen.
    # Tjänsten laddar ner SCB:s öppna data (CC0) och räknar server-side. POST
    # /calc tar emot en GeoJSON-yta; nedladdning från SCB kan ta en stund så
    # timeouten är generös. client_max_body_size rymmer även uppladdade ytor.
    location /proxy/befolkning/ {
        auth_request /internal/auth_check;
        error_page 401 = @login_redirect;
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $befolkning_upstream http://befolkning:3005;
        rewrite ^/proxy/befolkning/(.*)$ /befolkning/$1 break;
        proxy_pass $befolkning_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        client_max_body_size 10m;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # ---- Lantmateriet visningstjanster / WMTS-bakgrundskartor (Basic Auth) ----
    # Bakgrundskartorna (Topografisk webbkarta + Ortofoto) hamtas fran
    # Lantmateriets cache-WMTS. Basic Auth fran den gemensamma LM_USER/LM_PASS
    # injiceras har server-side (base64 raknas ut i 15-lm-basic-auth.envsh) sa
    # att uppgifterna aldrig lamnar containern. Klienten anropar
    # /proxy/lm-wmts/<tjanst>/...?WMTS-KVP och nginx vidarebefordrar till
    # maps.lantmateriet.se. Stigen efter /proxy/lm-wmts/ valjs i index.json sa
    # att den kan matchas mot din Geotorget-prenumeration utan att andra nginx.
    location /proxy/lm-wmts/ {
        proxy_pass https://maps.lantmateriet.se/;
        proxy_ssl_server_name on;
        proxy_set_header Host maps.lantmateriet.se;
        proxy_set_header Authorization "Basic ${LM_BASIC_AUTH}";
        proxy_set_header Origin "";
        proxy_set_header User-Agent "origo-proxy/1.0";
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
    }

    # ---- Lantmateriet Markhojd Direkt (OAuth2 via lm-oauth-sidecar) --------- #
    # Markhojd Direkt-API:t tar emot en GeoJSON-geometri (POST) och svarar med
    # samma geometri dar varje koordinat fatt ett Z-varde (1 m markhojdmodell).
    # Tjansten ligger bakom OAuth2 (WSO2) - Basic Auth funkar INTE har: gatewayen
    # api.lantmateriet.se svarar 401 med WWW-Authenticate: Bearer. Vi later darfor
    # lm-oauth-sidecaren hamta+cacha en Bearer-token (ur LM_OAUTH_KEY/SECRET, samma
    # som Fastighetsindelning) och lagga pa den server-side. Token-endpointen ligger
    # pa apimanager men sjalva hojd-API:t serveras bara av runtime-gatewayen
    # api.lantmateriet.se - darfor satter vi "X-LM-Upstream: api" sa sidecaren
    # vidarebefordrar dit (apimanager 302:ar for hojd). Klienten anropar
    # /proxy/lm-hojd/distribution/produkter/hojd/v1 (POST). Gated bakom
    # inloggningen (same-origin -> cookien foljer med).
    location /proxy/lm-hojd/ {
        auth_request /internal/auth_check;
        error_page 401 = @login_redirect;
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $lmoauth_hojd_upstream http://lm-oauth:3004;
        rewrite ^/proxy/lm-hojd/(.*)$ /$1 break;
        proxy_pass $lmoauth_hojd_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-LM-Upstream api;
        # Resursen /hojd kräver OAuth2-scopen markhojd_direkt_v1_read; utan den
        # svarar gatewayen 403 "Scope validation failed". Sidecaren begär och
        # cachar en token med just denna scope (separat från fastighet-token).
        proxy_set_header X-LM-Scope markhojd_direkt_v1_read;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "*" always;
    }

    # ---- Lantmateriet apimanager (OAuth2) via lm-oauth-sidecar -------------- #
    # OAuth2-tjansterna (t.ex. Fastighetsindelning-WMS) kraver en Bearer-token
    # som ar kortlivad (~1 h). lm-oauth-tjansten hamtar och cachar den automatiskt
    # ur LM_OAUTH_KEY/LM_OAUTH_SECRET (client credentials) och lagger pa
    # Authorization: Bearer server-side. Faller tillbaka pa en statisk
    # LM_BEARER_TOKEN om key/secret saknas. Klienten anropar bara
    # /proxy/lantmateriet/<tjanst>/v1/wms?... som vanligt.
    location /proxy/lantmateriet/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $lmoauth_upstream http://lm-oauth:3004;
        rewrite ^/proxy/lantmateriet/(.*)$ /$1 break;
        proxy_pass $lmoauth_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # ---- Sjofartsverket geokatalog (WMS bakom "Kartvisare Fyren") ------------ #
    # Alla lager i https://geokatalog.sjofartsverket.se/kartvisarefyren/ ar
    # vanliga WMS 1.3.0-tjanster under /MapService/wms.axd/<tjanst>. De svarar
    # utan autentisering men saknar CORS-headers, darav proxyn.
    location /proxy/sjofartsverket/ {
        proxy_pass https://geokatalog.sjofartsverket.se/;
        proxy_ssl_server_name on;
        proxy_set_header Host geokatalog.sjofartsverket.se;
        proxy_set_header Origin "";
        proxy_set_header User-Agent "origo-proxy/1.0";
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "*" always;
    }
}
