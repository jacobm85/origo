# Kopiera denna fil till ".env" på servern och fyll i värdena.
# .env är gitignorad — hemligheterna hamnar aldrig i git.
# docker-compose läser .env automatiskt. Applicera ändringar med:
#   docker compose up -d
#
# OBS: sätt INTE dessa via Portainers "recreate" på en container — det tappar
# compose-nätverkets alias (t.ex. "iono") så att nginx inte kan nå tjänsten.
# Använd alltid `docker compose up -d`.

# Inloggning till kartan (auth-tjänsten)
APP_USER=admin
APP_PASSWORD=byt-mig

# Kartans titel (visas i webbläsarens flik) och footer-texten (mitten av
# nedre listen). Lämna tomt för att behålla defaults från index.html /
# index.json.
MAP_TITLE=Origo karta
MAP_FOOTER_TEXT=Origo karta

# Lantmäteriet API-portal, OAuth2 Bearer (proxy /proxy/lantmateriet/)
LM_BEARER_TOKEN=

# Drönarflyg-lagret: var CSV:n ligger på servern (monteras in i konverteraren).
# Konverteraren skriver flightdata/drone-flights.geojson som origo serverar.
FLIGHTS_CSV_DIR=/mnt/SSD250/flights
FLIGHTS_CSV_NAME=DLB-Flights.csv

# Lantmäteriet "Jonosfär Direkt" Basic Auth (iono-tjänsten, /proxy/iono/)
IONO_USER=
IONO_PASS=

# Jonosfär-rutnätet (lagret över Sverige):
#  - Byggs en gång vid start och sedan enligt schemat nedan. Knappen
#    "Uppdatera rutnätet" i kartan triggar en ombyggnad på begäran.
#  - Standard: var 60:e minut (en gång i timmen). Sätt
#    IONO_GRID_REFRESH_EVERY_MIN=0 och IONO_GRID_REFRESH_AT=HH:MM för att
#    i stället uppdatera vid ett fast klockslag.
IONO_GRID_REFRESH_AT=07:00
IONO_GRID_REFRESH_EVERY_MIN=60
# Tidszon för schemat (07:00 svensk tid). Faller tillbaka till UTC utan tzdata.
TZ=Europe/Stockholm
# 6-gradig skala (Lantmäteriet) på "variability" (mm): 0-5,5-10,10-15,15-20,20-25,25-30+.
# IONO_BREAKS = övre gränser för de fem första klasserna; IONO_COLORS = sex färger.
IONO_BREAKS=5,10,15,20,25
IONO_COLORS=#a6d96a,#2e9e3f,#f2c200,#fdae61,#e8602c,#d23c1e
