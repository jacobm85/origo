# Kopiera denna fil till ".env" på servern och fyll i värdena.
# .env är gitignorad — hemligheterna hamnar aldrig i git.
# docker-compose läser .env automatiskt. Applicera ändringar med:
#   docker compose up -d
#
# OBS: sätt INTE dessa via Portainers "recreate" på en container — det tappar
# compose-nätverkets alias (t.ex. "iono") så att nginx inte kan nå tjänsten.
# Använd alltid `docker compose up -d`.

# Inloggning till kartan (auth-tjänsten)
APP_USER=admin
APP_PASSWORD=byt-mig

# Kartans titel (visas i webbläsarens flik) och footer-texten (mitten av
# nedre listen). Lämna tomt för att behålla defaults från index.html /
# index.json.
MAP_TITLE=Origo karta
MAP_FOOTER_TEXT=Origo karta

# === Lantmäteriet: EN gemensam inloggning för alla Lantmäteri-tjänster ======
# Samma användarnamn/lösenord (Geotorget) används för ortofoto (STAC-bild),
# Jonosfär Direkt och bakgrundskartorna (WMTS – Topografisk webbkarta +
# Ortofoto). nginx räknar ut Basic Auth server-side och injicerar den på
# /proxy/lm-wmts/, så uppgifterna lämnar aldrig containern. Sätt dem en gång:
LM_USER=
LM_PASS=
# Bakgrundskarta: den AVGIFTSFRIA "Topografisk webbkarta visning, översiktlig"
# (CC BY 4.0) proxas via /proxy/lm-wmts/ till maps.lantmateriet.se med samma
# Basic Auth (LM_USER/LM_PASS). Stigen väljs i index.json (source "lm-topowebb"):
#   /proxy/lm-wmts/open/topowebb-ccby/v1/wmts  (lager topowebb + topowebb_nedtonad)
# Laserdata (STAC-höjd) och ortofoto (STAC-bild) använder också LM_USER/LM_PASS.
# Markhöjd Direkt (höjdprofil-pluginet) går DÄREMOT via OAuth2 (se nedan) – det
# API:t ligger bakom WSO2/Bearer och accepterar inte Basic Auth.

# === Lantmäteriet API-portal, OAuth2 (proxy /proxy/lantmateriet/) ===========
# Används av OAuth2-skyddade tjänster, t.ex. Fastighetsindelning-WMS. OAuth2
# "client credentials" kräver BÅDA nycklarna nedan – en Consumer Key och en
# Consumer Secret, som du skapar per applikation i API-portalen
# (apimanager.lantmateriet.se). lm-oauth-tjänsten byter dem mot en kortlivad
# Bearer-token automatiskt (förnyas innan den går ut), så du slipper klistra in
# en token för hand. Detta är INTE samma som LM_USER/LM_PASS (Basic).
# Samma nycklar återanvänds av höjdprofilen (Markhöjd Direkt via /proxy/lm-hojd/);
# se till att API-portal-appen prenumererar på BÅDE Fastighetsindelning OCH höjd.
LM_OAUTH_KEY=
LM_OAUTH_SECRET=
# Global default-scope (lämna tom). OBS: höjdprofilen sätter sin egen scope
# (markhojd_direkt_v1_read) per anrop via nginx (X-LM-Scope) – den behöver INTE
# anges här, och en global scope skulle störa andra OAuth2-tjänster.
LM_OAUTH_SCOPE=
# LM_OAUTH_TOKEN_URL=https://apimanager.lantmateriet.se/oauth2/token
#
# Fallback (frivilligt): om du hellre klistrar in en redan genererad token i
# stället för key/secret. Den går ut efter ~1 h och förnyas INTE automatiskt.
LM_BEARER_TOKEN=

# === Data-refresh (schemalagd uppdatering av GeoJSON-lager) ==================
# data-refresh-tjänsten kör datagenererarna (TED-upphandlingar, Länsstyrelsens
# vattenverksamhet, Försvarsmaktens riksintressen m.fl.) och skriver till ./data
# som origo serverar. Intervall i timmar och äldsta publiceringsår för TED:
REFRESH_INTERVAL_HOURS=24
TED_FROM_YEAR=2021
# Sätt till false för att hoppa över körningen direkt vid start (kör först efter intervallet):
REFRESH_RUN_ON_START=true

# Drönarflyg-lagret: var CSV:n ligger på servern (monteras in i konverteraren).
# Konverteraren skriver flightdata/drone-flights.geojson som origo serverar.
FLIGHTS_CSV_DIR=/mnt/SSD250/flights
FLIGHTS_CSV_NAME=DLB-Flights.csv

# Jonosfär-rutnätet (lagret över Sverige):
#  - Byggs en gång vid start och sedan enligt schemat nedan. Knappen
#    "Uppdatera rutnätet" i kartan triggar en ombyggnad på begäran.
#  - Standard: var 60:e minut (en gång i timmen). Sätt
#    IONO_GRID_REFRESH_EVERY_MIN=0 och IONO_GRID_REFRESH_AT=HH:MM för att
#    i stället uppdatera vid ett fast klockslag.
IONO_GRID_REFRESH_AT=07:00
IONO_GRID_REFRESH_EVERY_MIN=60
# Tidszon för schemat (07:00 svensk tid). Faller tillbaka till UTC utan tzdata.
TZ=Europe/Stockholm
# 6-gradig skala (Lantmäteriet) på "variability" (mm): 0-5,5-10,10-15,15-20,20-25,25-30+.
# IONO_BREAKS = övre gränser för de fem första klasserna; IONO_COLORS = sex färger.
IONO_BREAKS=5,10,15,20,25
IONO_COLORS=#a6d96a,#2e9e3f,#f2c200,#fdae61,#e8602c,#d23c1e

# Lantmäteriet STAC-bild (ortofoto-tjänsten, /api/ortofoto/) använder den
# gemensamma LM_USER/LM_PASS ovan.
# Övre gränser per nedladdning: antal rutor och total zip-storlek (byte).
# Ortofoton är stora (ofta ~0,5–1 GB/ruta), så håll urvalet rimligt.
ORTOFOTO_MAX_FILES=100
ORTOFOTO_MAX_BYTES=53687091200

# Lantmäteriet STAC-höjd (höjddata-tjänsten, /api/laserdata/) hämtar laserdata
# (punktmoln, LAZ/COPC) OCH markhöjdmodell (1 m DTM, GeoTIFF) direkt från
# Lantmäteriet med samma gemensamma LM_USER/LM_PASS ovan. Produkt väljs i kartan;
# tillåtna collections (allowlist) styrs av LASERDATA_COLLECTIONS:
#LASERDATA_COLLECTIONS=dsm-skoglig-copc,dtm-cog
# Sessions-priming (TEST): laserdata ger 403 tills en lyckad nedladdning av
# markhöjdmodellen gjorts – tjänsten gör därför ett GET mot en markhöjd-ruta vid
# start (och vid 403) och återanvänder sessions-cookien. Begäran skickas med
# Range: bytes=0-0 och avbryts direkt – filen hämtas inte hem. Stäng av med
# LASERDATA_PRIME=false. Default-mål är en liten markhöjd-ruta (~80 kB); byt med
# LASERDATA_PRIME_URL eller LASERDATA_PRIME_COLLECTION (fallback, default mhm-67_4).
# Sessionen lever ~1 min och hålls vid liv genom att primea om var
# LASERDATA_PRIME_KEEPALIVE_SEC sekund (default 50; 0 = av).
#LASERDATA_PRIME=true
#LASERDATA_PRIME_URL=https://dl1.lantmateriet.se/hojd/data/grid1m/67_4/05/67475_4875_25.tif
#LASERDATA_PRIME_KEEPALIVE_SEC=50
# Övre gränser per nedladdning: antal rutor och total zip-storlek (byte).
LASERDATA_MAX_FILES=200
LASERDATA_MAX_BYTES=53687091200

# Frivillig reprojektion server-side ("Konvertera till lokalt SWEREF"-kryssrutan
# i kartan). När den är ikryssad laddas varje ruta hem, reprojiceras med
# gdalwarp (markhöjdmodell/ortofoto) eller pdal (laserdata) och läggs sedan i
# zip:en. Sätt *_CONVERT_ENABLED=false för att dölja kryssrutan/neka konvertering.
# CONVERT_CRS_ALLOW styr tillåtna mål-CRS (gemensam för båda tjänsterna); tom =
# default (SWEREF 99 TM + de tolv lokala zonerna EPSG:3006–3018).
#LASERDATA_CONVERT_ENABLED=true
#ORTOFOTO_CONVERT_ENABLED=true
#CONVERT_CRS_ALLOW=EPSG:3006,EPSG:3007,EPSG:3008,EPSG:3009,EPSG:3010,EPSG:3011,EPSG:3012,EPSG:3013,EPSG:3014,EPSG:3015,EPSG:3016,EPSG:3017,EPSG:3018
