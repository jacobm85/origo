# Sjökortsplotter – exempel på .env
#
# Kopiera till .env och fyll i. Filen är gitignorerad.
#   cp .env.example .env
#
# OBS: sätt INTE dessa via Portainers "recreate" på en container — det tappar
# variabler som inte redan finns satta. Använd .env och `docker compose up -d`.

# Publik port på hosten som kartan nås på (containern lyssnar internt på 80).
# Default 8080 om variabeln utelämnas. Nås sedan på http://<host>:<ORIGO_PORT>.
ORIGO_PORT=8080

# === Inloggning ============================================================
# Session-auth framför hela kartan. Byt lösenordet innan driftsättning.
APP_USER=admin
APP_PASSWORD=byt-mig

# === Texter ================================================================
# Fliktitel resp. text i footern. Lämna tomma för att behålla värdena från
# index.html respektive index.json.
MAP_TITLE=Sjökortsplotter
MAP_FOOTER_TEXT=

# Inloggningsskärmens rubrik och valfri underrubrik.
LOGIN_TITLE=Sjökortsplotter
LOGIN_SUBTITLE=

# === Vad som INTE behövs i den här varianten ===============================
# Plottern sparar spår, rutter och punkter i webbläsarens localStorage, och
# sjökortet hämtas som öppen WMS från Sjöfartsverket via nginx-proxyn. Därför
# finns här inga inloggningsuppgifter till Lantmäteriet, ingen GeoServer och
# ingen PostGIS — allt det ligger på grenen master.
